{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "jsx": "react-jsx",
    "outDir": "ts-out",
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    { "path": "../../packages/ui" },
    { "path": "../../packages/editor" },
    { "path": "../../packages/platform" }
  ]
}
