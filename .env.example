# Copy to .env. Do not put a real key in this file.

# Default provider. The key stays on the loopback server.
# XAI_API_KEY=replace-with-a-local-key
# UVCP_AI_MODEL=grok-4.7

# Local Ollama:
# UVCP_AI_PROVIDER=ollama
# UVCP_AI_MODEL=qwen2.5:7b
# UVCP_AI_BASE_URL=http://127.0.0.1:11434/v1

# Another OpenAI-compatible provider:
# UVCP_AI_PROVIDER=compatible
# UVCP_AI_BASE_URL=https://example.invalid/v1
# UVCP_AI_MODEL=example-model
# UVCP_AI_API_KEY=replace-with-a-local-key
