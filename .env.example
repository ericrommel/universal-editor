# Optional developer setup. The application can choose a provider without this file.
# Copy to .env. Do not put a real key in this file.
# A named provider keeps its own address. UVCP_AI_BASE_URL does not move it.
# An xAI key is not sent to another provider.

# OpenAI
# UVCP_AI_PROVIDER=openai
# UVCP_AI_MODEL=gpt-6-astra
# UVCP_AI_API_KEY=replace-with-a-local-key

# Anthropic
# UVCP_AI_PROVIDER=anthropic
# UVCP_AI_MODEL=claude-sonnet-5-5
# UVCP_AI_API_KEY=replace-with-a-local-key

# Gemini
# UVCP_AI_PROVIDER=gemini
# UVCP_AI_MODEL=gemini-3.8-flash
# UVCP_AI_API_KEY=replace-with-a-local-key

# OpenRouter
# UVCP_AI_PROVIDER=openrouter
# UVCP_AI_MODEL=openrouter/auto
# UVCP_AI_API_KEY=replace-with-a-local-key

# xAI. This is the fallback when UVCP_AI_PROVIDER is unset.
# XAI_API_KEY=replace-with-a-local-key
# UVCP_AI_MODEL=grok-4.7

# Local Ollama. The application does not install it.
# UVCP_AI_PROVIDER=ollama
# UVCP_AI_MODEL=qwen2.5:7b
# UVCP_AI_BASE_URL=http://127.0.0.1:11434/v1

# Another OpenAI-compatible provider:
# UVCP_AI_PROVIDER=compatible
# UVCP_AI_BASE_URL=https://example.invalid/v1
# UVCP_AI_MODEL=example-model
# UVCP_AI_API_KEY=replace-with-a-local-key
